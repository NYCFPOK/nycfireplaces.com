---
// A showroom product/solution page built for a conversation, not a checkout.
import { Image } from 'astro:assets';
import LivingHero from '../../components/LivingHero.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import FaqList from '../../components/FaqList.astro';
import OptionCard from '../../components/OptionCard.astro';
import FitHelper from '../../components/islands/FitHelper.tsx';
import { fireForOption } from '../../data/fire';
import { getCollection, getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { metaDescription } from '../../data/site';
import ProjectCard from '../../components/ProjectCard.astro';
import ShowroomInfo from '../../components/ShowroomInfo.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site, telHref } from '../../data/site';

export async function getStaticPaths() {
  return (await getCollection('options')).map((option) => ({ params: { id: option.id }, props: { option } }));
}
const { option } = Astro.props;
const o = option.data;
const related = (await getEntries(o.relatedProjects)).filter(Boolean);
const PARENT = {
  'new-fireplace': ['Add a new fireplace', '/fireplaces/new/'],
  'existing-fireplace': ['Upgrade an existing fireplace', '/fireplaces/upgrade-existing/'],
  'outdoor-kitchen': ['Outdoor kitchens', '/outdoor-kitchens/'],
  'outdoor-living': ['Outdoor fire & heating', '/outdoor-living/'],
} as const;
const TYPE = { 'new-fireplace': 'new-fireplace', 'existing-fireplace': 'existing-fireplace', 'outdoor-kitchen': 'outdoor-kitchen', 'outdoor-living': 'outdoor-fire-heat' } as const;
const [parentLabel, parentHref] = PARENT[o.path];
const quoteHref = `/project-help/?kind=product&product=${encodeURIComponent(o.title)}&type=${TYPE[o.path]}`;
const isFireplace = o.path === 'new-fireplace' || o.path === 'existing-fireplace';
const siblings = (await getCollection('options')).filter((x) => x.data.path === o.path && x.id !== option.id).sort((a, b) => a.data.order - b.data.order);
const installs = related.flatMap((p) => p.data.images.slice(0, 2).map((src) => ({ src, alt: p.data.title }))).slice(0, 6);
const FAQ = { 'new-fireplace': 'fireplaces', 'existing-fireplace': 'existing', 'outdoor-kitchen': 'outdoor-kitchens', 'outdoor-living': 'outdoor-kitchens' } as const;
const productSchema = { '@context': 'https://schema.org', '@type': 'Product', name: o.title, description: o.whatItIs, image: new URL(o.image.src, site.url).href, category: parentLabel, brand: { '@type': 'Organization', name: site.name } };
---
<Base title={`${o.title}: What It Is and Who It Suits`} description={metaDescription(`${o.whatItIs} ${o.goodFor}`)} quote={{ href: quoteHref, label: 'Get a quote on this' }} breadcrumbs={[[parentLabel, parentHref], [o.title, `/products/${option.id}/`]]} schema={[productSchema]}>
  <LivingHero image={o.image} alt={o.imageAlt} effects={fireForOption(option.id)} eyebrow={parentLabel} title={o.title} lede={o.whatItIs} crumbs={[[parentLabel, parentHref]]} placement="product_top" quoteHref={quoteHref} position={o.imagePosition} id={`product-${option.id}`}>
    <p class="good"><strong>A good starting point for:</strong> {o.goodFor}</p>
    <p class="price">{o.priceNote ?? 'Contact us for pricing. The appliance is one part of the cost; we quote the complete project once we understand it.'}</p>
    <p class="display">{o.showroomDisplay === 'confirmed' ? 'On display in our Maspeth showroom.' : 'Want to see one running? Call ahead and we will tell you which models are on display in Maspeth.'}</p>
  </LivingHero>

  {o.variants.length > 0 && (
    <section class="section variants" data-variants>
      <div class="wrap">
        <h2>See it your way</h2>
        <div class="v-stage">{o.variants.map((v, i) => <Image src={v.image} alt={`${o.title}: ${v.label}`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 800px, 100vw" class:list={[{ 'is-on': i === 0 }]} data-variant={i} />)}</div>
        <div class="v-controls" role="group" aria-label="Choose a look">{o.variants.map((v, i) => <button type="button" aria-pressed={i === 0} data-variant-btn={i}><small>{v.group}</small>{v.label}</button>)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap cols">
      <div>
        <h2>What to know</h2>
        <ul class="ticks big">{o.facts.map((f) => <li>{f}</li>)}</ul>
        <h2 class="mt">Things that affect the fit</h2>
        <ul class="ticks">{o.considerations.map((c) => <li>{c}</li>)}</ul>
        <p class="muted small">Whether this suits your home is confirmed after we look at the details, and installation always follows the manufacturer’s instructions.</p>
      </div>
      <div>
        {(o.included.length > 0 || o.separate.length > 0) && (
          <div class="card scope">
            <h2>Planning the whole project</h2>
            {o.included.length > 0 && (<><h3>Typically part of the appliance</h3><ul class="ticks">{o.included.map((x) => <li>{x}</li>)}</ul></>)}
            {o.separate.length > 0 && (<><h3>Usually needed separately</h3><ul class="plain">{o.separate.map((x) => <li>{x}</li>)}</ul></>)}
            <p class="muted small">Your written quote lists exactly what is and is not included, so nothing is assumed.</p>
          </div>
        )}
        {o.exampleBrands.length > 0 && (
          <div class="brands">
            <h3>Makers we often work with for this</h3>
            <p>{o.exampleBrands.join(' · ')}</p>
            <p class="muted small">Ask us about a specific model. <a class="link" href="/brands/">All brands</a></p>
          </div>
        )}
        <details class="docs">
          <summary>Technical documents and specifications</summary>
          <div>
            {o.documents.length > 0
              ? <ul>{o.documents.map((d) => <li><a class="link" href={d.url} rel="noopener">{d.label}</a></li>)}</ul>
              : <p>Installation manuals, framing dimensions and clearances are specific to each model. Tell us which model you are considering and we will send the manufacturer’s documents. Designers and builders: <a class="link" href="/designers-builders/">see trade support</a>.</p>}
          </div>
        </details>
      </div>
    </div>
  </section>

  {isFireplace && (
    <section class="section section-tint">
      <div class="wrap cols">
        <div>
          <p class="eyebrow">From a real install</p>
          <h2>{o.path === 'existing-fireplace' ? 'Before and after' : 'From bare wall to finished fireplace'}</h2>
          <p class="lede">Drag the handle to compare.</p>
          <div class="gap"><BeforeAfter pair={o.path === 'existing-fireplace' ? 'insert' : 'new'} /></div>
        </div>
        <div class="card fit-card">
          <p class="eyebrow">Will it fit?</p>
          <h2>Tell us about the opening</h2>
          <p class="muted">Three quick answers point you to the right type. Our team confirms the actual fit.</p>
          <div class="gap"><FitHelper client:visible phone={site.phone.display} tel={telHref} /></div>
        </div>
      </div>
    </section>
  )}

  {installs.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Real installs</h2>
        <p class="lede">Tap any photo to enlarge.</p>
        <div class="gap"><ProjectGallery images={installs} /></div>
        <ul class="proj-links">{related.map((p) => <li><a class="link link-arrow" href={`/projects/${p.id}/`}>{p.data.title}</a></li>)}</ul>
      </div>
    </section>
  )}

  <section class="section section-tint"><div class="wrap wrap-narrow"><h2>Common questions</h2><div class="gap"><FaqList group={FAQ[o.path]} limit={6} /></div></div></section>

  {siblings.length > 0 && (
    <section class="section">
      <div class="wrap"><h2>Related options</h2><div class="grid3">{siblings.map((x) => <OptionCard option={x} />)}</div>
      <p class="finance muted">Planning the budget? Ask us about financing through Acorn Finance.</p></div>
    </section>
  )}

  <section class="section" id="ask">
    <div class="wrap final">
      <div>
        <h2>Ask about this product</h2>
        <p class="lede">Tell us a little about the space and we will let you know whether this is a sensible fit, or point you to something better suited.</p>
        <div class="card info"><ShowroomInfo placement="product_contact" compact /></div>
      </div>
      <div class="card form-card"><LeadForm kind="product" product={o.title} projectType={TYPE[o.path]} id="lead-product" /></div>
    </div>
  </section>

</Base>
<script>
  document.querySelectorAll<HTMLElement>('[data-variants]').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('[data-variant-btn]').forEach((btn) => btn.addEventListener('click', () => {
      root.querySelectorAll('[data-variant]').forEach((img) => img.classList.toggle('is-on', (img as HTMLElement).dataset.variant === btn.dataset.variantBtn));
      root.querySelectorAll('[data-variant-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    }));
  });
</script>
<style>
  .good { margin-top: 1.1rem; }
  .price { margin-top: 0.8rem; font-size: 0.95rem; color: #cdbfae; }
  .display { margin-top: 0.4rem; font-weight: 600; font-size: 0.95rem; }
  .gap { margin-top: 1.5rem; }
  .fit-card { padding: clamp(1.25rem, 3vw, 1.9rem); align-self: start; }
  .proj-links { list-style: none; padding: 0; margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }
  .finance { margin-top: 2rem; }
  .v-stage { display: grid; margin-top: 1.25rem; }
  .v-stage :global(img) { grid-area: 1 / 1; width: 100%; height: auto; border-radius: var(--radius-card); opacity: 0; transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
  .v-stage :global(img.is-on) { opacity: 1; }
  .v-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .v-controls button { min-height: 2.9rem; padding: 0.3rem 1rem; border-radius: 999px; border: 1.5px solid #b9aa95; background: #fff; font: inherit; font-weight: 600; cursor: pointer; display: grid; text-align: left; }
  .v-controls button[aria-pressed='true'] { border-color: var(--color-ember); background: var(--color-ember-soft); }
  .v-controls small { font-size: 0.7rem; color: var(--color-ink-3); text-transform: uppercase; letter-spacing: 0.08em; }
  .top { background: var(--color-paper-2); border-bottom: 1px solid var(--color-line); padding-block: clamp(1.5rem, 4vw, 3.5rem); }
  .top-grid { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 900px) { .top-grid { grid-template-columns: 1fr 1fr; gap: 3.5rem; } }
  .media :global(img) { border-radius: var(--radius-card); width: 100%; height: auto; max-height: 34rem; object-fit: cover; box-shadow: var(--shadow-card); }
  .cap { font-size: 0.85rem; margin-top: 0.5rem; }
  .crumbs { font-size: 0.9rem; color: var(--color-ink-3); margin-bottom: 0.8rem; }
  .crumbs a { text-decoration: underline; }
  h1 { margin-bottom: 0.9rem; }
  .good { margin-top: 1rem; }
  .benefit { margin-top: 0.6rem; font-family: var(--font-display); font-size: 1.25rem; }
  .acts { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }
  .price { margin-top: 1.1rem; font-size: 0.97rem; }
  .display { margin-top: 0.5rem; font-weight: 600; font-size: 0.97rem; }
  .cols { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .cols { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }
  h2 { font-size: clamp(1.4rem, 2.6vw, 1.85rem); margin-bottom: 1rem; }
  .mt { margin-top: 2.25rem; }
  .big { font-size: 1.1rem; }
  .small { font-size: 0.93rem; margin-top: 1rem; }
  .scope { padding: 1.5rem; }
  .scope h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; margin: 1rem 0 0.5rem; }
  .plain { list-style: disc; padding-left: 1.2rem; display: grid; gap: 0.35rem; }
  .brands { margin-top: 1.75rem; }
  .brands h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; margin-bottom: 0.3rem; }
  .docs { margin-top: 1.75rem; border: 1px solid var(--color-line); border-radius: 10px; }
  .docs summary { padding: 0.9rem 1rem; font-weight: 650; }
  .docs div { padding: 0 1rem 1rem; color: var(--color-ink-2); }
  .grid3 { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  @media (min-width: 640px) { .grid3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .grid3 { grid-template-columns: repeat(3, 1fr); } }
  .final { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .final { grid-template-columns: 0.85fr 1.15fr; gap: 4rem; } }
  .info { padding: 1.4rem; margin-top: 1.75rem; }
  .form-card { padding: clamp(1.25rem, 3vw, 2rem); }
  .sticky-call { display: none; }
  @media (min-width: 768px) {
    .sticky-call { display: flex; position: sticky; bottom: 0; z-index: 30; align-items: center; justify-content: center; gap: 1.25rem; padding: 0.6rem 1rem; background: var(--color-paper); border-top: 1px solid var(--color-line); font-weight: 650; }
    .sticky-call .btn { min-height: 2.6rem; padding-block: 0.4rem; }
  }
</style>
