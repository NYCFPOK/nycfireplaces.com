---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import LeadForm from '../components/LeadForm.astro';
import ShowroomInfo from '../components/ShowroomInfo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { site, telHref } from '../data/site';
import showroom from '../assets/showroom/showroom-165.jpg';
const projects = (await getCollection('projects', (p) => Boolean(p.data.designer) && !p.data.draft)).slice(0, 3);
const help = [
  ['Product selection', 'We help match a fireplace, grill or heater to the space, the construction type and the design intent, and say so when something will not work.'],
  ['Specifications', 'Manufacturer installation manuals, framing dimensions, clearances and BTU requirements for the models under consideration.'],
  ['Venting and utility planning', 'Early review of vent routes and gas and electrical needs, so they can be planned before framing and finishes.'],
  ['Outdoor kitchen layouts', 'Appliance layouts covering grills, side burners, refrigeration, storage and ventilation, with 3D layouts available for outdoor kitchen projects.'],
  ['Coordination', 'We work alongside your GC, plumber and electrician through rough-in and final installation, or supply equipment only while your team installs.'],
  ['Showroom for client meetings', 'Bring clients to Maspeth to see fireplaces, mantels and outdoor appliances in person. Call ahead so we can prepare.'],
];
---
<Base title="For Designers, Architects & Builders — Specification & Project Support" description="A practical partner for designers, architects and builders: product selection, specifications, venting and layout planning, supply and installation coordination. Call 718-326-4328.">
  <PageHero eyebrow="Designers, architects and builders" title="A practical partner for designers and builders." lede="Bring us in while the drawings are still flexible. We help you specify fireplaces and outdoor kitchens that fit the building, then coordinate with your trades to get them installed." image={showroom} imageAlt="Stone fireplace wall with a linear fireplace in our showroom" placement="trade_hero" helpQuery="?kind=trade" />

  <section class="section">
    <div class="wrap">
      <h2>How we help on trade projects</h2>
      <div class="grid">{help.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}</div>
      <p class="note muted">We install to manufacturer specifications. Permits, inspections and code compliance remain with the project’s licensed professionals; we provide the product documentation they need. Ask us about trade pricing for your firm.</p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap cols">
      <div>
        <h2>When to involve us</h2>
        <p class="lede">Ideally at design or early framing. That is when vent paths, gas line placement, framing clearances and appliance layouts are easiest to get right.</p>
        <ul class="ticks gap">
          <li><strong>Planning and design:</strong> fireplace type, venting strategy and appliance layout.</li>
          <li><strong>Framing and rough-in:</strong> the unit is typically set so venting and gas can be routed.</li>
          <li><strong>Finishes:</strong> mantels, surrounds, media walls and countertops are completed later.</li>
        </ul>
      </div>
      <div class="card resources">
        <h2>Technical resources</h2>
        <ul>
          <li><a class="link" href="/products/">Product types and the makers we work with</a></li>
          <li><a class="link" href="/brands/">Brand directory</a></li>
          <li><a class="link" href="/guides/fireplace-without-a-chimney/">Guide: fireplaces without a chimney</a></li>
          <li><a class="link" href="/guides/planning-an-outdoor-kitchen/">Guide: planning an outdoor kitchen</a></li>
        </ul>
        <p class="muted">Need a manual, cut-out dimensions or a spec sheet for a particular model? Tell us the model and we will send the manufacturer’s current documents.</p>
      </div>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="wrap"><h2>Projects completed with design and build partners</h2><div class="grid3">{projects.map((p) => <ProjectCard project={p} />)}</div></div>
    </section>
  )}

  <section class="section section-tint"><div class="wrap wrap-narrow"><h2>Trade questions</h2><div class="gap"><FaqList group="trade" /></div></div></section>

  <section class="section" id="discuss">
    <div class="wrap cols">
      <div>
        <h2>Discuss a project or send plans</h2>
        <p class="lede">Tell us where the project stands. Attach drawings if you have them, or call and ask for our trade team.</p>
        <p class="call"><a class="link" href={telHref} data-track="phone_click" data-placement="trade_form">{site.phone.display}</a></p>
        <div class="card info"><ShowroomInfo placement="trade_contact" compact /></div>
      </div>
      <div class="card form-card"><LeadForm kind="trade" id="lead-trade" /></div>
    </div>
  </section>
</Base>
<style>
  .grid { display: grid; gap: 1.5rem 2.5rem; margin-top: 2rem; }
  @media (min-width: 700px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .item { border-top: 2px solid var(--color-ember); padding-top: 1rem; }
  .item h3 { margin-bottom: 0.4rem; }
  .item p { color: var(--color-ink-2); }
  .note { margin-top: 2rem; max-width: 50rem; font-size: 0.97rem; }
  .cols { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .cols { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .gap { margin-top: 1.5rem; }
  .resources { padding: 1.6rem; display: grid; gap: 1rem; }
  .resources h2 { font-size: 1.4rem; }
  .resources ul { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .grid3 { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  @media (min-width: 640px) { .grid3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .grid3 { grid-template-columns: repeat(3, 1fr); } }
  .call { font-size: 1.6rem; margin-top: 0.8rem; }
  .info { padding: 1.4rem; margin-top: 1.75rem; }
  .form-card { padding: clamp(1.25rem, 3vw, 2rem); }
</style>
