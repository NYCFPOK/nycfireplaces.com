    ],
  }}
  questions={[
    'Roughly how wide, tall and deep is the opening?',
    'Is the fireplace masonry or a factory-built metal box?',
    'Is there gas in the house, and how close is it to the fireplace?',
    'Do you want heat, atmosphere, or both?',
    'Do you like the mantel and surround, or should those change too?',
  ]}
  projectCategories={['fireplace-upgrade']}
