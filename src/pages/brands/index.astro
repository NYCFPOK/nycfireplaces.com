---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
const brands = await getCollection('brands');
const groups = ['Fireplaces & hearth', 'Mantels, doors & accessories', 'Grills & outdoor kitchens', 'Pizza ovens', 'Outdoor fire & heating'];
---
<Base title="Brands We Work With" description="The fireplace, grill, outdoor kitchen and outdoor heating makers we help customers choose from. Ask us about a specific model.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Brands</p>
      <h1>Makers we work with</h1>
      <p class="lede">A reference list for people who already have a name in mind. If you do not, <a class="link" href="/start-here/">start here instead</a>. Choosing the type of product comes before choosing the brand.</p>
      {groups.map((g) => (
        <div class="group">
          <h2>{g}</h2>
          <ul>{brands.filter((b) => b.data.group === g).sort((a, b) => a.data.name.localeCompare(b.data.name)).map((b) => <li><a href={`/${b.id}/`}><strong>{b.data.name}</strong><span>{b.data.summary}</span></a></li>)}</ul>
        </div>
      ))}
    </div>
  </section>
  <CtaBand placement="brands_band" heading="Looking for a particular model?" text="Tell us the brand and model. We will confirm availability, whether it is on display, and whether it suits your space." />
</Base>
<style>
  h1 { margin-block: 0.6rem 1rem; }
  .group { margin-top: 3rem; }
  .group h2 { font-size: 1.5rem; margin-bottom: 1rem; }
  ul { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
  @media (min-width: 700px) { ul { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { ul { grid-template-columns: repeat(3, 1fr); } }
  li a { display: grid; gap: 0.15rem; padding: 0.9rem 1.1rem; background: #fff; border: 1px solid var(--color-line); border-radius: 12px; text-decoration: none; height: 100%; }
  li a:hover { border-color: var(--color-ember); }
  li span { color: var(--color-ink-3); font-size: 0.93rem; }
</style>
