---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const all = await getCollection('projects', (p) => !p.data.draft);
  return all.map((project) => ({
    params: { id: project.id },
    props: { project, more: all.filter((x) => x.data.category === project.data.category && x.id !== project.id).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.year ?? 0) - (a.data.year ?? 0)).slice(0, 3) },
  }));
}
const { project, more } = Astro.props;
const p = project.data;
const CAT = {
  'fireplace-new': ['New fireplace', '/fireplaces/new/', 'new-fireplace'],
  'fireplace-upgrade': ['Fireplace upgrade', '/fireplaces/upgrade-existing/', 'existing-fireplace'],
  'outdoor-kitchen': ['Outdoor kitchen', '/outdoor-kitchens/', 'outdoor-kitchen'],
  'outdoor-living': ['Outdoor fire & heating', '/outdoor-living/', 'outdoor-fire-heat'],
} as const;
const [catLabel, catHref, type] = CAT[p.category];
const caseStudy = [['The goal', p.goal], ['What was selected', p.solution], ['What our team did', p.ourRole], ['Worth knowing', p.takeaway]].filter(([, v]) => v);
const fallback = `${p.title}, a completed ${catLabel.toLowerCase()} project by NYC Fireplaces & Outdoor Kitchens.`;
const source = p.summary ?? p.description ?? '';
const description = (source.length >= 60 ? source : fallback).slice(0, 158);
---
<Base title={`${p.title} — Completed Project`} description={description}>
  <article class="section">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="crumbs"><a href="/">Home</a> / <a href="/projects/">Our Projects</a></nav>
      <p class="eyebrow">{catLabel}{p.location && ` · ${p.location}`}{p.year && ` · ${p.year}`}</p>
      <h1>{p.title}</h1>
      {p.summary && <p class="lede">{p.summary}</p>}
      <div class="layout">
        <div class="gallery">
          {p.images.map((img, i) => (
            <Image src={img} alt={`${p.title}, photo ${i + 1} of ${p.images.length}`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 700px, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
          ))}
          {p.beforeAfter && <p class="muted small">These photos include the space before the work.</p>}
        </div>
        <aside>
          {caseStudy.length > 0 && (
            <dl class="case">{caseStudy.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}</dl>
          )}
          {p.description && (<><h2>From our project notes</h2><p class="notes">{p.description}</p></>)}
          {p.designer && <p class="credit"><strong>Designed with:</strong> {p.designer}</p>}
          {p.features && p.features.length > 0 && <ul class="chips">{p.features.map((f) => <li class="chip">{f}</li>)}</ul>}
          <div class="card ask">
            <h2>Planning something similar?</h2>
            <p>Tell us what caught your eye. You do not need to know the product names.</p>
            <a class="btn btn-primary" href={`/project-help/?type=${type}`} data-track="help_cta_click" data-placement="project_detail">Get Help With My Project</a>
            <a class="link link-arrow" href={catHref}>How to start: {catLabel.toLowerCase()}</a>
          </div>
        </aside>
      </div>
    </div>
  </article>
  {more.length > 0 && (
    <section class="section section-tint">
      <div class="wrap"><h2>More projects like this</h2><div class="grid3">{more.map((m) => <ProjectCard project={m} />)}</div></div>
    </section>
  )}
  <CtaBand placement="project_band" helpQuery={`?type=${type}`} />
</Base>
<style>
  .crumbs { font-size: 0.9rem; color: var(--color-ink-3); margin-bottom: 1rem; }
  .crumbs a { text-decoration: underline; }
  h1 { margin-block: 0.5rem 0.9rem; max-width: 24ch; }
  .layout { display: grid; gap: 2.5rem; margin-top: 2rem; }
  @media (min-width: 900px) { .layout { grid-template-columns: 1.5fr 1fr; gap: 3.5rem; align-items: start; } aside { position: sticky; top: 8rem; } }
  .gallery { display: grid; gap: 1rem; }
  .gallery :global(img) { width: 100%; height: auto; border-radius: var(--radius-card); background: var(--color-paper-3); }
  .small { font-size: 0.93rem; }
  aside { display: grid; gap: 1.25rem; }
  aside h2 { font-size: 1.3rem; }
  .case { display: grid; gap: 0.25rem; }
  .case dt { font-weight: 700; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ember); margin-top: 0.9rem; }
  .case dt:first-child { margin-top: 0; }
  .notes { color: var(--color-ink-2); margin-top: -0.75rem; }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ask { padding: 1.4rem; display: grid; gap: 0.8rem; justify-items: start; }
  .grid3 { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  @media (min-width: 640px) { .grid3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .grid3 { grid-template-columns: repeat(3, 1fr); } }
</style>
