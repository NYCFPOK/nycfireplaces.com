---
// Homepage. Photography first, few words. Long explanations live on the
// product and category pages; this page gets people to a path or a call.
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import LivingImage from '../components/LivingImage.astro';
import FireMoment from '../components/FireMoment.astro';
import Carousel from '../components/Carousel.astro';
import Reviews from '../components/Reviews.astro';
import FaqList from '../components/FaqList.astro';
import QuoteFlow from '../components/QuoteFlow.astro';
import { site, showroom, telHref, helpHref, addressLine, hoursCompact } from '../data/site';
import showroomPhoto from '../assets/showroom/showroom-141.jpg';

const photo = async (slug: string, n = 0) => (await getEntry('projects', slug))!.data.images[n];

// HERO. Swap this for a 2400 px+ photo, or pass `video` to LivingImage, when supplied.
const hero = await photo('stunning-wood-to-gas-hargrove-colonial-cannon-ball-spheres', 1);
const heroSet = await Promise.all([480, 800, 1124, 1440].map(async (w) => `${(await getImage({ src: hero, width: w })).src} ${w}w`));
const heroSizes = '100vw';

const paths = [
  { title: 'Add a new fireplace', href: '/fireplaces/new/', image: await photo('modern-fireplace'), alt: 'Linear fireplace built into a stone media wall' },
  { title: 'Upgrade an existing fireplace', href: '/fireplaces/upgrade-existing/', image: await photo('wood-to-gas-fireplace-conversion'), alt: 'Existing fireplace converted to gas' },
  { title: 'Plan an outdoor kitchen', href: '/outdoor-kitchens/', image: await photo('xo-42-gas-grill-and-gozney-dome-dual-fuel-pizza-oven-with-challenger-o'), alt: 'L-shaped outdoor kitchen with a built-in grill and pizza oven' },
];

const order = ['new-fireplace', 'existing-fireplace', 'outdoor-kitchen'];
const options = (await getCollection('options'))
  .filter((o) => o.data.homepage)
  .sort((a, b) => order.indexOf(a.data.path) - order.indexOf(b.data.path) || a.data.order - b.data.order)
  .slice(0, 6);
const projects = (await getCollection('projects', (p) => p.data.featured && !p.data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const LABEL = { 'fireplace-new': 'New fireplace', 'fireplace-upgrade': 'Fireplace upgrade', 'outdoor-kitchen': 'Outdoor kitchen', 'outdoor-living': 'Outdoor fire' } as const;

const steps = [
  ['Tell us about it', 'Call, visit or send a photo.'],
  ['Narrow the options', 'We point you to the few that suit.'],
  ['Plan the setup', 'Scope and parts, in a written quote.'],
  ['Installed', 'By our team, or supplied to yours.'],
];
---
<Base
  title="Fireplaces & Outdoor Kitchens in NYC: Showroom, Design & Installation | NYC Fireplaces & Outdoor Kitchens"
  description="Find the right fireplace or outdoor kitchen with expert help. Visit our Maspeth, Queens showroom or call 718-326-4328. You don't need a model number to get started."
>
  <link slot="head" rel="preload" as="image" fetchpriority="high" imagesrcset={heroSet.join(', ')} imagesizes={heroSizes} />

  <!-- Hero: fire first. -->
  <section class="hero cinema">
    <LivingImage class="hero-bg" src={hero} alt="Gas fire burning over stone spheres in a dark marble fireplace we converted from wood" eager fill motion="parallax" id="home-hero" position="50% 52%" sizes={heroSizes} widths={[480, 800, 1124, 1440]}
      effects={[
        { t: 'flames', r: [41.5, 45.5, 7.5, 14.5] },
        { t: 'flames', r: [57, 44.5, 7, 14] },
        { t: 'glow', r: [27, 50, 46, 20], i: 0.55 },
        { t: 'embers', r: [40, 46, 26, 10], i: 0.5 },
      ]} />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <h1 class="lines">
        <span class="line" style="--n:0"><span>Find the right fireplace</span></span>
        <span class="line" style="--n:1"><span>or outdoor kitchen,</span></span>
        <span class="line" style="--n:2"><span>with expert help.</span></span>
      </h1>
      <p class="lede" data-reveal style="--d:340ms">No model number or finished plan needed.</p>
      <div class="acts" data-reveal style="--d:420ms">
        <a class="btn btn-primary btn-lg" data-magnetic href={telHref} data-track="phone_click" data-placement="hero">{site.cta.call}</a>
        <a class="btn btn-secondary btn-lg help" href={helpHref} data-track="help_cta_click" data-placement="hero">{site.cta.help}</a>
      </div>
      <p class="visit" data-reveal style="--d:500ms"><a class="link link-arrow" href="/showroom/" data-track="showroom_info_click" data-placement="hero">{site.cta.visit}</a></p>
    </div>
  </section>
  <p class="proof">Family-owned <span aria-hidden="true">·</span> <span data-count="30">30</span>+ years of team experience <span aria-hidden="true">·</span> Showroom in Maspeth, Queens</p>

  <!-- Three starting paths: photographs, not cards. -->
  <section class="section" aria-labelledby="paths-h">
    <div class="wrap">
      <h2 id="paths-h" data-reveal>What are you planning?</h2>
      <div class="paths">
        {paths.map((p, i) => (
          <a class="path" href={p.href} data-reveal style={`--d:${i * 90}ms`} data-track="path_click" data-placement={p.href}>
            <Image src={p.image} alt={p.alt} widths={[400, 640, 900]} sizes="(min-width: 900px) 33vw, 100vw" width={900} height={1000} fit="cover" />
            <span class="path-title">{p.title}<i aria-hidden="true">→</i></span>
          </a>
        ))}
      </div>
      <p class="escape">Not sure? <a class="link" href={telHref} data-track="phone_click" data-placement="paths">Call {site.phone.display}</a> or <a class="link" href="/start-here/">answer three questions</a>.</p>
    </div>
  </section>

  <!-- Fire moment 1 -->
  <FireMoment image={await photo('before-and-after-kozy-heat-installation', 2)} alt="Gas insert burning in a stacked-stone fireplace we installed" id="home-moment-insert" position="50% 80%" top zoom="1.45 52% 80%"
    effects={[{ t: 'flames', r: [44, 71, 24, 13] }, { t: 'glow', r: [36, 66, 38, 24], i: 0.5 }, { t: 'embers', r: [44, 70, 24, 8], i: 0.4 }]}
    line="The fireplace you have, finally one you use." href="/fireplaces/upgrade-existing/" cta="Upgrade an existing fireplace" />

  <!-- Featured options: swipe, one line each. -->
  <section class="section" aria-labelledby="options-h">
    <div class="wrap">
      <h2 id="options-h" data-reveal>Start with these options</h2>
      <div class="gap">
        <Carousel label="Featured options">
          {options.map((o) => (
            <a class="slide" href={`/products/${o.id}/`}>
              <Image src={o.data.image} alt={o.data.imageAlt} widths={[320, 520, 760]} sizes="(min-width: 900px) 30vw, 78vw" width={760} height={950} fit="cover" position={o.data.imagePosition} />
              <strong>{o.data.title}</strong>
              <span>{o.data.benefit}</span>
            </a>
          ))}
        </Carousel>
      </div>
      <p class="after"><a class="link link-arrow" href="/products/">Explore more models</a></p>
    </div>
  </section>

  <!-- From idea to installed: four short steps. -->
  <section class="section section-tint" aria-labelledby="process-h">
    <div class="wrap">
      <h2 id="process-h" data-reveal>From idea to installed</h2>
      <ol class="steps">
        {steps.map(([t, d], i) => <li data-reveal style={`--d:${i * 80}ms`}><span class="n" aria-hidden="true">{i + 1}</span><strong>{t}</strong><span>{d}</span></li>)}
      </ol>
    </div>
  </section>

  <!-- Real projects: swipe. -->
  <section class="section" aria-labelledby="proof-h">
    <div class="wrap">
      <h2 id="proof-h" data-reveal>Real projects, from our own job sites</h2>
      <div class="gap">
        <Carousel label="Completed projects">
          {projects.map((p) => (
            <a class="slide wide" href={`/projects/${p.id}/`}>
              <Image src={p.data.images[0]} alt={p.data.title} widths={[360, 600, 900]} sizes="(min-width: 900px) 44vw, 84vw" width={900} height={675} fit="cover" />
              <strong>{p.data.title}</strong>
              <span>{LABEL[p.data.category]}{p.data.location && ` · ${p.data.location}`}{p.data.year && ` · ${p.data.year}`}</span>
            </a>
          ))}
        </Carousel>
      </div>
      <p class="after"><a class="link link-arrow" href="/projects/">See all projects</a></p>
      <Reviews limit={3} marquee />
    </div>
  </section>

  <!-- Fire moment 2: the showroom. -->
  <FireMoment image={showroomPhoto} alt="Our Maspeth showroom, with linear and traditional fireplaces burning" id="home-moment-showroom" position="72% 60%" align="left"
    effects={[
      { t: 'flames', r: [76.6, 62.2, 20.6, 4.6] }, { t: 'flames', r: [7.2, 51, 9.6, 2.6], i: 0.8 }, { t: 'flames', r: [37.2, 48.3, 4, 2.8], i: 0.8 },
      { t: 'glow', r: [36.6, 68, 5, 7.5] }, { t: 'glow', r: [50.2, 73.5, 5.6, 6] }, { t: 'glow', r: [28.4, 61.6, 4.8, 5] },
    ]}
    line="See it burning before you decide.">
    <p class="where" data-reveal style="--d:120ms">{addressLine}<br />{hoursCompact}</p>
    <div class="acts" data-reveal style="--d:200ms">
      <a class="btn btn-primary" href={showroom.directionsUrl} target="_blank" rel="noopener" data-track="directions_click" data-placement="home_showroom">Get Directions</a>
      <a class="btn btn-secondary" href="/showroom/" data-track="showroom_info_click" data-placement="home_showroom">Plan a visit</a>
    </div>
  </FireMoment>

  <!-- Designers and builders: one line. -->
  <section class="section trade" aria-labelledby="trade-h">
    <div class="wrap trade-in">
      <h2 id="trade-h" data-reveal>A practical partner for designers and builders.</h2>
      <div class="acts">
        <a class="btn btn-primary" href="/project-help/?kind=trade" data-track="help_cta_click" data-placement="home_trade">Discuss a project</a>
        <a class="btn btn-secondary" href="/designers-builders/">How we work with the trade</a>
      </div>
    </div>
  </section>

  <!-- A few questions, then the form. -->
  <section class="section section-tint" aria-labelledby="faq-h">
    <div class="wrap wrap-narrow">
      <h2 id="faq-h">Before you call</h2>
      <div class="gap"><FaqList group="home" limit={4} /></div>
      <p class="after"><a class="link link-arrow" href="/guides/">More questions and guides</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="form-h">
    <div class="wrap final">
      <div>
        <h2 id="form-h">Let’s make your project easier to figure out.</h2>
        <p class="bigphone"><a href={telHref} data-track="phone_click" data-placement="home_final">{site.phone.display}</a></p>
      </div>
      <div class="form-card"><QuoteFlow id="lead-home" /></div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero { position: relative; min-height: min(90svh, 56rem); display: grid; align-items: end; overflow: hidden; }
  .hero :global(.hero-bg) { position: absolute; inset: 0; height: 100%; }
  /* Push the fire to the right of the frame so the headline never sits on it. */
  .hero :global(.hero-bg > img), .hero :global(.hero-bg > .living-canvas) { transform: scale(1.28) translate3d(0, var(--py, 0px), 0); transform-origin: 0% 56%; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(12 8 6 / 0.82) 0%, rgb(12 8 6 / 0.5) 34%, rgb(12 8 6 / 0) 62%), linear-gradient(0deg, rgb(12 8 6 / 0.7) 0%, transparent 34%); }
  .hero-inner { position: relative; padding-block: clamp(6rem, 16vh, 10rem) clamp(3rem, 8vh, 5rem); }
  .hero h1 { color: #fff; font-size: clamp(2.1rem, 4.6vw, 3.9rem); max-width: 19ch; margin-bottom: 1rem; }
  .hero .lede { font-weight: 600; color: #f0e6d8; }
  .acts { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.4rem; }
  .visit { margin-top: 1rem; }
  @media (max-width: 767px) {
    /* Phone: the fire fills the top of the first screen, the words sit beneath it. */
    .hero { min-height: 0; display: block; }
    .hero :global(.hero-bg) { position: relative; inset: auto; height: min(42svh, 22rem); }
    .hero :global(.hero-bg > img), .hero :global(.hero-bg > .living-canvas) { transform: scale(1.5); transform-origin: 52% 60%; }
    .hero-shade { height: min(42svh, 22rem); bottom: auto; background: linear-gradient(0deg, #0f0b09 0%, rgb(15 11 9 / 0) 30%); }
    .hero-inner { padding-block: 0.4rem 1.6rem; }
    .hero h1 { font-size: clamp(1.6rem, 7.3vw, 2.3rem); margin-bottom: 0.6rem; }
    .acts { margin-top: 1rem; }
    .acts .btn { width: 100%; }
    .acts .help { display: none; } /* "Get Project Help" is always in the dock on phones */
    .visit { margin-top: 0.8rem; }
  }
  .proof { background: #0f0b09; color: #cdbfae; text-align: center; font-size: 0.9rem; padding: 0.9rem 1.25rem 1.1rem; border-top: 1px solid #2a211c; }
  .proof span[aria-hidden] { margin-inline: 0.35rem; color: #6d5d50; }
  @media (max-width: 767px) { .proof { padding-bottom: 5.5rem; } } /* clears the dock on the first screen */

  /* ---- Shared ---- */
  h2 { max-width: 22ch; }
  .gap { margin-top: 1.75rem; }
  .after { margin-top: 1.5rem; }
  .section { padding-block: clamp(3.5rem, 9vw, 7rem); }

  /* ---- Paths ---- */
  .paths { display: grid; gap: 0.9rem; margin-top: 1.75rem; }
  @media (min-width: 900px) { .paths { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
  .path { position: relative; display: block; overflow: hidden; border-radius: 10px; aspect-ratio: 16 / 10; background: var(--color-paper-3); }
  @media (min-width: 900px) { .path { aspect-ratio: 4 / 5; } }
  .path :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
  .path::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(12 8 6 / 0.78) 0%, rgb(12 8 6 / 0) 55%); }
  .path-title { position: absolute; z-index: 1; left: 1.1rem; right: 1.1rem; bottom: 1rem; display: flex; justify-content: space-between; align-items: end; gap: 1rem; color: #fff; font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 1.75rem); line-height: 1.15; }
  .path-title i { font-style: normal; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  @media (hover: hover) { .path:hover :global(img) { transform: scale(1.04); } .path:hover i { transform: translateX(5px); } }
  .escape { margin-top: 1.5rem; }

  /* ---- Carousel slides ---- */
  .slide { width: 78vw; max-width: 22rem; display: grid; gap: 0.2rem; align-content: start; align-self: flex-start; text-decoration: none; }
  .slide.wide { width: 84vw; max-width: 36rem; }
  .slide.wide :global(img) { aspect-ratio: 4 / 3; }
  .slide :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; background: var(--color-paper-3); margin-bottom: 0.7rem; }
  .slide strong { font-family: var(--font-display); font-weight: 560; font-size: 1.3rem; line-height: 1.2; }
  .slide span { color: var(--color-ink-3); font-size: 0.97rem; }
  .slide:hover strong { color: var(--color-ember); }

  /* ---- Steps ---- */
  .steps { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: 1.4rem 2rem; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .steps li { display: grid; gap: 0.2rem; align-content: start; }
  .steps .n { font-family: var(--font-display); font-size: 2.2rem; line-height: 1; color: var(--color-ember); margin-bottom: 0.4rem; }
  .steps strong { font-size: 1.08rem; }
  .steps li > span:last-child { color: var(--color-ink-2); font-size: 0.97rem; }

  /* ---- Showroom moment ---- */
  .where { color: #e9dfd0; }

  /* ---- Trade ---- */
  .trade-in { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 900px) { .trade-in { grid-template-columns: 1.3fr 1fr; } .trade-in .acts { margin-top: 0; justify-content: end; } }

  /* ---- Final ---- */
  .final { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 900px) { .final { grid-template-columns: 0.8fr 1.2fr; gap: 4rem; } }
  .bigphone a { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.75rem); color: var(--color-ember); text-decoration: none; display: inline-block; margin-top: 0.8rem; }
  .form-card { background: #fff; border-radius: var(--radius-card); padding: clamp(1.1rem, 3vw, 2rem); box-shadow: var(--shadow-card); }
</style>
