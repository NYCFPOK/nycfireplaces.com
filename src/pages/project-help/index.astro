---
// Server-rendered: receives every form on the site. On a validation error it
// re-renders the same form with the visitor's values and visible messages.
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import ShowroomInfo from '../../components/ShowroomInfo.astro';
import { handleLead, LEAD_KINDS, PROJECT_TYPES, type LeadKind, type LeadValues, type LeadErrors } from '../../lib/leads';
import { site, telHref } from '../../data/site';

export const prerender = false;

const q = Astro.url.searchParams;
let kind: LeadKind = LEAD_KINDS.includes(q.get('kind') as LeadKind) ? (q.get('kind') as LeadKind) : 'project';
let values: LeadValues = {};
let errors: LeadErrors = {};
let formId = `lead-${kind}`;

if (Astro.request.method === 'POST') {
  try {
    const result = await handleLead(Astro.request, Astro.clientAddress);
    kind = result.kind;
    formId = `lead-${kind}`;
    if (result.ok) return Astro.redirect(`/thank-you/?kind=${kind}`, 303);
    values = result.values;
    errors = result.errors;
    Astro.response.status = 422;
  } catch (err) {
    console.error('[leads] unexpected error', err);
    errors = { form: `Something went wrong on our side and your message was not sent. Please call us at ${site.phone.display}, or try again.` };
    Astro.response.status = 500;
  }
}
const typeParam = q.get('type') ?? '';
const projectType = PROJECT_TYPES.some(([v]) => v === typeParam) ? typeParam : '';
const product = (q.get('product') ?? '').slice(0, 120);
if (product && kind === 'project') kind = 'product';

const COPY: Record<LeadKind, { h: string; p: string }> = {
  project: { h: 'Let’s make your project easier to figure out.', p: 'Share what you know. A sentence or two is enough, and you do not need a model number or a finished plan.' },
  product: { h: 'Ask about this product', p: 'Tell us a little about the space and we will let you know whether it is a sensible fit.' },
  trade: { h: 'Discuss a project or send plans', p: 'For designers, architects, builders and contractors. Tell us where the project stands and attach drawings if you have them.' },
  service: { h: 'Request service', p: 'For fireplaces and outdoor equipment that we sold and installed.' },
  parts: { h: 'Request a part', p: 'Describe the part as best you can. A photo and the brand or model help, but are not required.' },
};
---
<Base title={kind === 'service' ? 'Request Service' : kind === 'parts' ? 'Request a Part' : kind === 'trade' ? 'Discuss a Trade Project' : 'Get Help With Your Project'} description="Send us a few details about your fireplace or outdoor kitchen project and our team will get back to you to talk it through. Or call 718-326-4328." hideMobileBar>
  <section class="section">
    <div class="wrap grid">
      <div>
        <h1>{COPY[kind].h}</h1>
        <p class="lede">{COPY[kind].p}</p>
        <p class="call">Rather talk? <a class="link" href={telHref} data-track="phone_click" data-placement="help_page">Call {site.phone.display}</a></p>
        {kind === 'service' && <p class="notice">Our service team works on units that we sold and installed. If you are not sure whether yours came from us, send the details and we will check.</p>}
        {(kind === 'project' || kind === 'product') && (
          <p class="switch muted">Need something else? <a href="/project-help/?kind=service">Request service</a> · <a href="/project-help/?kind=parts">Request a part</a> · <a href="/project-help/?kind=trade">Trade inquiry</a></p>
        )}
        <div class="card info"><ShowroomInfo placement="help_page" compact /></div>
      </div>
      <div class="card form-card">
        <LeadForm kind={kind} values={values} errors={errors} projectType={projectType} product={product} id={formId} page={values.page || (Astro.request.headers.get('referer') ? new URL(Astro.request.headers.get('referer')!).pathname : '/project-help/')} />
      </div>
    </div>
  </section>
</Base>
<style>
  .grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .grid { grid-template-columns: 0.85fr 1.15fr; gap: 4rem; } }
  @media (max-width: 899px) { .info { display: none; } }
  h1 { font-size: clamp(1.9rem, 4vw, 2.75rem); margin-bottom: 1rem; }
  .call { margin-top: 1.1rem; font-size: 1.15rem; font-weight: 650; }
  .notice { margin-top: 1.25rem; padding: 1rem 1.2rem; background: var(--color-ember-soft); border-radius: 10px; }
  .switch { margin-top: 1rem; font-size: 0.95rem; }
  .switch a { text-decoration: underline; }
  .info { padding: 1.4rem; margin-top: 2rem; }
  .form-card { padding: clamp(1.25rem, 3vw, 2rem); }
</style>
