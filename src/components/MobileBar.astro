---
// Mobile bottom dock: Call, Showrooms, Get a Quote. It hides while scrolling
// down, returns on scroll up, and stays out of the way of any form in use.
import { telHref, helpHref } from '../data/site';
---
<nav class="dock" aria-label="Quick actions" data-dock>
  <a href={telHref} data-track="phone_click" data-placement="dock">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.21Z"/></svg>
    <span>Call</span>
  </a>
  <a href="/showroom/" data-track="showroom_info_click" data-placement="dock">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="10" r="2.6"/></svg>
    <span>Showrooms</span>
  </a>
  <a href={helpHref} class="primary" data-track="help_cta_click" data-placement="dock"><span>Get a Quote</span></a>
</nav>
<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    let lastY = scrollY, formInView = false, typing = false;
    const apply = (hide: boolean) => dock.classList.toggle('is-hidden', hide || formInView || typing);
    addEventListener('scroll', () => {
      const y = scrollY;
      if (Math.abs(y - lastY) < 8) return;
      apply(y > lastY && y > 240);
      lastY = y;
    }, { passive: true });
    // Never sit on top of a form's buttons.
    const io = new IntersectionObserver((entries) => {
      formInView = entries.some((e) => e.isIntersecting) || [...document.querySelectorAll('form[data-lead-form], .msf')].some((f) => { const r = f.getBoundingClientRect(); return r.top < innerHeight * 0.85 && r.bottom > innerHeight * 0.4; });
      apply(false);
    }, { rootMargin: '-40% 0px -15% 0px' });
    const watch = () => document.querySelectorAll('form[data-lead-form], .msf, .quote-flow').forEach((f) => io.observe(f));
    watch(); setTimeout(watch, 2500);
    document.addEventListener('focusin', (e) => { typing = !!(e.target as HTMLElement).closest('form'); apply(false); });
    document.addEventListener('focusout', () => { typing = false; });
  }
</script>
<style>
  .dock {
    position: fixed; left: 0.6rem; right: 0.6rem; bottom: calc(0.6rem + env(safe-area-inset-bottom)); z-index: 40;
    display: grid; grid-template-columns: 1fr 1fr 1.5fr; gap: 0.35rem; padding: 0.35rem;
    background: #1c1613; border-radius: 18px; box-shadow: 0 12px 34px -10px rgb(0 0 0 / 0.55);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s;
  }
  .dock.is-hidden { transform: translateY(140%); opacity: 0; pointer-events: none; }
  .dock a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.1rem; min-height: 3.25rem; border-radius: 13px; color: #f3ece1; text-decoration: none; font-size: 0.78rem; font-weight: 650; }
  .dock a.primary { background: var(--color-ember); color: #fff; font-size: 1rem; font-weight: 750; }
  @media (min-width: 768px) { .dock { display: none; } }
  @media (prefers-reduced-motion: reduce) { .dock { transition: none; } }
</style>
