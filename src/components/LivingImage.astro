---
// A real photo with living fire laid over it. Effects are listed as percentage
// rectangles of the image: [x, y, width, height].
//
//   flames  gas and wood fires, fire tables, fire pits (never on a photo with no visible fire)
//   embers  sparse rising sparks
//   glow    heaters, lit oven mouths, grill interiors: breathing warm light only
//   shimmer heat haze above grills and burners (desktop only)
//   smoke   thin wisps, very low opacity
//
// Calibrate rectangles in the browser with ?calibrate=1 (not available in production).
// If real burn footage exists, pass `video` and it is used instead of the simulated effect.
import { Image } from 'astro:assets';
import type { Effect } from '../lib/living';
interface Props {
  src: ImageMetadata;
  alt: string;
  effects?: Effect[];
  motion?: 'none' | 'parallax' | 'reveal';
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  ratio?: string;
  position?: string;
  video?: { webm?: string; mp4: string };
  id?: string;
  class?: string;
}
const { src, alt, effects = [], motion = 'none', widths = [480, 800, 1124, 1600], sizes = '100vw', eager = false, ratio, position = 'center', video, id, class: cls } = Astro.props;
const fire = effects.length > 0 && !video;
---
<div class:list={['living', cls, { 'has-fire': fire, 'no-crop': !ratio }]} data-living={fire || video ? '' : undefined} data-effects={fire ? JSON.stringify(effects) : undefined} data-motion={motion} data-living-id={id} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <Image src={src} alt={alt} widths={widths.filter((w) => w <= Math.max(src.width, 480))} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} style={`object-position:${position}`} />
  {video && (
    <video muted loop playsinline preload="none" aria-hidden="true" data-src={video.mp4} style={`object-position:${position}`}>
      {video.webm && <source data-src={video.webm} type="video/webm" />}
    </video>
  )}
</div>
