---
import { site, showroom, telHref, hoursRows } from '../data/site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Plan a project', links: [
    ['Start Here', '/start-here/'], ['Add a new fireplace', '/fireplaces/new/'], ['Upgrade an existing fireplace', '/fireplaces/upgrade-existing/'],
    ['Plan an outdoor kitchen', '/outdoor-kitchens/'], ['Fire pits, heating & pizza ovens', '/outdoor-living/'], ['Our Projects', '/projects/'],
  ] },
  { title: 'More', links: [
    ['Designers & Builders', '/designers-builders/'], ['Service & Parts', '/service-parts/'], ['About Our Team', '/about/'],
    ['Buying Guides', '/guides/'], ['Explore more models', '/products/'], ['Brands we work with', '/brands/'], ['Areas we serve', '/service-areas/'],
  ] },
];
---
<footer class="section-dark footer">
  <div class="wrap grid">
    <div>
      <p class="f-name">{site.name}</p>
      <address>
        {showroom.street}<br />{showroom.city}, {showroom.region} {showroom.postalCode}
      </address>
      <p class="f-phone"><a href={telHref} data-track="phone_click" data-placement="footer">{site.phone.display}</a></p>
      <dl class="f-hours">
        {hoursRows.map((r) => (<><dt>{r.label}</dt><dd>{r.value}</dd></>))}
      </dl>
      <p><a class="link" href={showroom.directionsUrl} target="_blank" rel="noopener" data-track="directions_click" data-placement="footer">Get directions to the showroom</a></p>
      {site.otherLocations.filter((l) => l.status !== 'hidden').map((l) => (
        <p class="muted f-other">{l.name}: {l.publicNote}</p>
      ))}
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <p class="f-title">{c.title}</p>
        <ul>{c.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
    ))}
    <div>
      <p class="f-title">Already know what you need?</p>
      <p class="muted">Grills, parts and accessories are sold through our separate online store.</p>
      <p><a class="link" href={site.shopOnline.url} rel="noopener" data-track="shop_online_click" data-placement="footer">Shop Online at nycfireplaceshop.com ↗</a></p>
      <ul class="f-social">
        {site.social.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap f-legal">
    <span>© {year} {site.name}</span>
    <a href="/privacy/">Privacy</a><a href="/terms-of-service/">Terms</a><a href="/accessibility/">Accessibility</a>
  </div>
</footer>
<style>
  .footer { padding-block: 3.5rem 2rem; font-size: 0.98rem; }
  .grid { display: grid; gap: 2.5rem; }
  @media (min-width: 720px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .grid { grid-template-columns: 1.3fr 1fr 1fr 1.1fr; } }
  .f-name { font-family: var(--font-display); font-size: 1.3rem; margin-bottom: 0.6rem; color: #fff; }
  address { font-style: normal; }
  .f-phone a { font-size: 1.5rem; font-weight: 800; color: #fff; text-decoration: none; display: inline-block; padding-block: 0.4rem; }
  .f-hours { display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 1rem; margin-block: 0.4rem 1rem; color: #dccfbe; }
  .f-other { margin-top: 1rem; font-size: 0.92rem; }
  .f-title { font-weight: 700; color: #fff; margin-bottom: 0.7rem; }
  ul { list-style: none; padding: 0; display: grid; gap: 0.15rem; }
  nav a, .f-social a { text-decoration: none; color: #dccfbe; display: inline-block; padding-block: 0.3rem; }
  nav a:hover, .f-social a:hover { color: #fff; text-decoration: underline; }
  .f-social { display: flex; flex-wrap: wrap; gap: 0.2rem 1.1rem; margin-top: 1rem; }
  .f-legal { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid #40342c; color: #b8a996; font-size: 0.9rem; }
  .f-legal a { color: inherit; }
</style>
