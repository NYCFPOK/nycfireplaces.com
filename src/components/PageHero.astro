---
import { Image } from 'astro:assets';
import { site, telHref, helpHref } from '../data/site';
interface Props { eyebrow?: string; title: string; lede: string; image?: ImageMetadata; imageAlt?: string; placement: string; helpQuery?: string; crumbs?: [string, string][] }
const { eyebrow, title, lede, image, imageAlt = '', placement, helpQuery = '', crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class:list={['wrap', 'inner', { 'has-image': image }]}>
    <div>
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs"><a href="/">Home</a>{crumbs.map(([l, h]) => <><span aria-hidden="true"> / </span><a href={h}>{l}</a></>)}</nav>
      )}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <div class="acts">
        <a class="btn btn-primary btn-lg" href={telHref} data-track="phone_click" data-placement={placement}>{site.cta.call}</a>
        <a class="btn btn-secondary btn-lg" href={`${helpHref}${helpQuery}`} data-track="help_cta_click" data-placement={placement}>{site.cta.help}</a>
      </div>
      <slot />
    </div>
    {image && (
      <div class="media"><Image src={image} alt={imageAlt} widths={[480, 720, 1000]} sizes="(min-width: 900px) 520px, 100vw" width={1000} height={750} fit="cover" loading="eager" fetchpriority="high" /></div>
    )}
  </div>
</section>
<style>
  .page-hero { background: var(--color-paper-2); border-bottom: 1px solid var(--color-line); padding-block: clamp(2rem, 5vw, 4rem); }
  .inner { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .inner.has-image { grid-template-columns: 1.1fr 0.9fr; gap: 3.5rem; } }
  .crumbs { font-size: 0.9rem; color: var(--color-ink-3); margin-bottom: 1rem; }
  .crumbs a { text-decoration: underline; text-underline-offset: 2px; }
  .eyebrow { margin-bottom: 0.7rem; }
  h1 { margin-bottom: 1rem; max-width: 20ch; }
  .acts { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.6rem; }
  .media { border-radius: var(--radius-card); overflow: hidden; aspect-ratio: 4 / 3; box-shadow: var(--shadow-card); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
