# Copy to .env (never commit .env). All values are read on the server only,
# except the two PUBLIC_ ones, which are safe to expose in the browser.

# --- Environment ---------------------------------------------------------
# "production" makes the site indexable. Anything else = noindex everywhere.
SITE_ENV=staging
PORT=4321
# Password for staging/preview, as user:password. Leave empty in production.
STAGING_BASIC_AUTH=
# Build-time: extra hostnames the preview is served on (comma separated).
PREVIEW_HOSTS=

# --- Lead delivery -------------------------------------------------------
# file = store only (local development and automated tests)
# smtp = store, then email to the addresses below
LEAD_DELIVERY=file
# Where leads and uploads are stored. Must be on a persistent disk.
LEAD_DATA_DIR=.data
# Staging: use test inboxes here, never the live sales team.
LEAD_TO_SALES=
LEAD_TO_SERVICE=
LEAD_TO_PARTS=
LEAD_TO_TRADE=
LEAD_FROM=website@nycfireplaces.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional: also POST each lead as JSON to a CRM / automation endpoint.
LEAD_WEBHOOK_URL=
# Optional: Slack-style webhook that is told when a stored lead fails to deliver.
LEAD_ALERT_WEBHOOK_URL=

# --- Spam protection (optional, recommended for launch) -------------------
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional) -------------------------------------------------
# Google Tag Manager container ID. Events are pushed to dataLayer either way.
PUBLIC_GTM_ID=
